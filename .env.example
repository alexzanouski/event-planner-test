# Copy to .env and fill in. Never commit .env.
# Claude Code authentication is handled by `claude login` or ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=

# Publishing to Cloudflare (/publish-site). Not needed if you use
# `npx wrangler login`. Token permission: Workers Scripts - Edit.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Site name, default: event-planner-guides
CLOUDFLARE_SITE_NAME=
